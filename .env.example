# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb://127.0.0.1:27017/tinder_clone

# JWT Secret Configuration
JWT_ACCESS_SECRET=your_jwt_access_secret_key_change_me_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_me_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary Configuration (For Photo Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Agora Configuration (For Audio/Video Calling Tokens)
AGORA_APP_ID=28db9ee2823f4111a98c7a55e155d6ee
AGORA_APP_CERTIFICATE=40f8ca35f35649a4aafef27b74f4dc22
# Firebase Configuration (Path to serviceAccountKey.json)
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebaseServiceAccountKey.json

# SMTP Configuration (Optional, for OTP Mail Verification - fallback logs to console)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=no-reply@tinderclone.com
